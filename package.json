{
  "name": "mobilis",
  "version": "2.0.0-dev.0",
  "private": true,
  "description": "Mobilis — exercices de réadaptation MSK guidés par caméra (pose 2D) et coach vocal Gemini. Site web + APK Android.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lang && vite build && npm run verify:dist",
    "build:lang": "node scripts/build-lang.mjs",
    "verify:dist": "node scripts/check-dist.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . && npm run lint:deps && prettier --check .",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:legacy": "node scripts/run-legacy-tests.mjs",
    "test:e2e": "node tests/overlay.e2e.mjs && node tests/rom.e2e.mjs && node tests/camera.e2e.mjs",
    "test:e2e:dist": "MOBILIS_WWW=dist npm run test:e2e",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "fetch-model": "bash scripts/fetch-model.sh",
    "vendor": "bash scripts/vendor.sh",
    "serve": "npx serve www",
    "serve:dist": "npx serve dist",
    "android:sync": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@mediapipe/tasks-vision": "1.1.1",
    "@types/node": "^22.20.5",
    "dependency-cruiser": "^18.8.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "playwright": "^1.63.0",
    "prettier": "^3.10.1",
    "qrcode-generator": "^2.0.4",
    "typescript": "~6.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18"
  }
}
