rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque patient ne voit que ses propres données
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /sessions/{sid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
