rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque patient ne voit que ses propres données
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /sessions/{sid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    // Programmes préparés par un clinicien (aucune donnée nominative du patient)
    match /rx/{code} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.by == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.by == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.by == request.auth.uid && request.resource.data.by == request.auth.uid;
      // Suivi que le patient choisit de partager : visible par lui et par le clinicien auteur
      match /progress/{pid} {
        allow create, update: if request.auth != null && request.auth.uid == pid;
        allow read: if request.auth != null && (request.auth.uid == pid || get(/databases/$(database)/documents/rx/$(code)).data.by == request.auth.uid);
      }
    }
  }
}
